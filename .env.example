# Copy to .env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# TikTok API for Business (business account)
TIKTOK_BUSINESS_ID=
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API (professional account)
IG_USER_ID=
IG_ACCESS_TOKEN=

# publish.mode=api only: public URL that serves the runs/ directory (e.g. an R2/S3 bucket)
PUBLIC_MEDIA_BASE_URL=

# Optional: Slack or Discord incoming webhook, pinged when an episode needs review
REVIEW_WEBHOOK_URL=
